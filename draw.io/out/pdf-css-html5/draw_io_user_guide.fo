                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title4"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Understanding the draw.io editor</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 4 - <!--content(text)--><fo:inline>Understanding the draw.io editor</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 4 - <!--content(text)--><fo:inline>Understanding the draw.io editor</fo:inline></fo:marker><fo:inline>Chapter 4. </fo:inline><fo:inline>Understanding the draw.io
                                editor</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="unique_4_Connect_42_fig_wtr_zjm_wkc" chfox:nd-id="fig_wtr_zjm_wkc"><fo:block end-indent="0" start-indent="0"><fo:inline chfox:inch="true" max-width="100%" id="unique_4_Connect_42_image_xtr_zjm_wkc" chfox:nd-id="image_xtr_zjm_wkc"><fo:inline><fo:external-graphic src="file:/C:/Users/Abhishek%20Roy/Downloads/drawio_UI_.drawio.png" max-width="100%" scaling="uniform" width="830in div 96" content-width="scale-to-fit" height="349in div 96" content-height="scale-to-fit"/></fo:inline></fo:inline></fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" margin-left="40px" margin-right="40px" space-before="1em" role="Figure" id="d191e365"><fo:block end-indent="0" start-indent="0">
                                    <fo:block page-break-after="avoid" font-style="normal"><fo:inline>Figure<fo:inline> 1</fo:inline><fo:inline>. </fo:inline></fo:inline><fo:inline><fo:inline>Figure: draw.io
                                            editor</fo:inline></fo:inline></fo:block>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The draw.io editor consists of the following areas:</fo:block></fo:block-container>
                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_4_Connect_42_ul_wsf_5qb_vkc" chfox:nd-id="ul_wsf_5qb_vkc">
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline font-weight="bold">Menu bar</fo:inline>. Provides
                                        access to file management commands, such as File and Edit,
                                        and editor commands, such as View, Arrange, Extras, and
                                        Help.</fo:block></fo:list-item-body></fo:list-item>
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline font-weight="bold">Toolbar</fo:inline>. Provides quick
                                        access to commonly used commands, such as Zoom, Undo, Redo,
                                        Delete, Fill Color, and Connection.</fo:block></fo:list-item-body></fo:list-item>
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline font-weight="bold">Left panel</fo:inline>. Provides
                                        shapes and other diagram elements that you can add to the
                                        canvas, such as circles, squares, diamonds, curves, and
                                        callouts.</fo:block></fo:list-item-body></fo:list-item>
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline font-weight="bold">Canvas</fo:inline>. Provides the
                                        workspace where you create and edit diagrams.</fo:block></fo:list-item-body></fo:list-item>
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:inline font-weight="bold">Right panel</fo:inline>. Provides
                                        options for managing the canvas view and formatting diagram
                                        elements, including grid and page settings and shape
                                        formatting.</fo:block></fo:list-item-body></fo:list-item>
                                </fo:list-block>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_5" chfox:nd-id="understanding_the_workspace"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title5"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Select a template</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 5 - <!--content(text)--><fo:inline>Select a template</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 5 - <!--content(text)--><fo:inline>Select a template</fo:inline></fo:marker><fo:inline>Chapter 5. </fo:inline><fo:inline>Select a template</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Templates are
                                        predesigned diagrams that provide a starting layout for
                                        different types of diagrams. draw.io provides a variety of
                                        templates. You can also select a blank diagram to create a
                                        diagram from scratch.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">When you select a
                                        template, you can enter a name for the diagram. The diagram
                                        is saved in the draw.io XML format by default. This is the
                                        editable format that you can use to continue editing the
                                        diagram in draw.io.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To select a
                                        template:</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block role="Sect">
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>On the draw.io editor, click
                                                  <fo:inline font-weight="bold">File</fo:inline> in the upper-left corner.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>From the menu, select <fo:inline font-weight="bold">New</fo:inline>.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:inline>In the dialog box, do one of
                                                the following:</fo:inline>
                                            <fo:block>
                                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="0em" space-before="0em" id="unique_5_Connect_42_ul_odp_1pb_vkc" chfox:nd-id="ul_odp_1pb_vkc">
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">◦ </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>To create a diagram from scratch, click <fo:inline font-weight="bold">Blank
                                                  Diagram</fo:inline>.</fo:block></fo:list-item-body></fo:list-item>
                                                  <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">◦ </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>To use a template, select the required template.
                                                  For example, select Flowchart.</fo:block></fo:list-item-body></fo:list-item>
                                                </fo:list-block>
                                            </fo:block>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item space-after="1em" space-before="1em"><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Next to <fo:inline font-weight="bold">Diagram Name</fo:inline>, enter the name of the
                                                diagram.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                </fo:block>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_5_Connect_42_result_mnv_vpb_vkc" chfox:nd-id="result_mnv_vpb_vkc"><fo:block end-indent="0" start-indent="0">The draw.io editor opens with the
                                    selected template. If you entered a diagram name, the name
                                    appears in the upper-left corner of the canvas.</fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="docum
                                                  <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" space-after.conditionality="retain" space-before.conditionality="retain"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="bold">Arrangement</fo:inline></fo:block></fo:block-container>
                                                  </fo:block></fo:table-cell>
                                                  <fo:table-cell start-indent="0" end-indent="0" border-bottom-color="rgb(0 , 0 , 0)" border-bottom-style="solid" border-bottom-width="1px" border-right-color="rgb(0 , 0 , 0)" border-right-style="solid" border-right-width="0" padding-bottom="0.3em" padding-left="0.3em" padding-right="0.3em" padding-top="0.3em" display-align="before"><fo:block>

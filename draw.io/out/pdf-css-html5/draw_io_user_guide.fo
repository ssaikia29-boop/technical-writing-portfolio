                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title2"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Introduction</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 2 - <!--content(text)--><fo:inline>Introduction</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 2 - <!--content(text)--><fo:inline>Introduction</fo:inline></fo:marker><fo:inline>Chapter 2. </fo:inline><fo:inline>Introduction</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_2_Connect_42_section_mb2_v4d_tkc" chfox:nd-id="section_mb2_v4d_tkc"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e775" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">About
                                        draw.io</fo:block></fo:block-container>
                                    <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">draw.io (also known as diagrams.net) in
                                        a diagramming tool. It is available as a web application and
                                        a desktop application, and through integrations with
                                        supported platforms. You can use it to create, edit and
                                        share a variety of diagrams including:<fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_2_Connect_42_ul_nd3_1pd_tkc" chfox:nd-id="ul_nd3_1pd_tkc">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Business process diagrams</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Flowcharts</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Organisation charts</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Architectural diagrams and layouts</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Unified Modeling Language (UML) diagrams</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Entity-Relationship (ER) diagrams</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Database schemas</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Business Process Model and Notation (BPMN)
                                                diagrams</fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>Circuit diagrams</fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block></fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_2_Connect_42_section_zts_wrd_tkc" chfox:nd-id="section_zts_wrd_tkc"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e817" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">About
                                        This Guide</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This user guide
                                        describes how to use the draw.io (version 32.2.0) in a web
                                        browser on desktop and laptop computers. It covers the
                                        features and workflows available through a web browser.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_2_Connect_42_section_c52_zrd_tkc" chfox:nd-id="section_c52_zrd_tkc"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container id="d38e829" page-break-after="avoid" font-size="1.17em" font-weight="700" space-after="0" margin-left="0" margin-right="0" space-before="1em" role="H2"><fo:block end-indent="0" start-indent="0">Intended
                                        Audience</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If you are a
                                        business analyst, project manager, IT professional,
                                        technical writer, student, educator, or anyone with little
                                        to no experience creating diagrams, you’re in the right
                                        place.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This user guide
                                        covers the basics of using draw.io to create, edit, format,
                                        save, and export diagrams.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Follow the
                                        step-by-step instructions to get started, or jump to the
                                        section you need.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="docum
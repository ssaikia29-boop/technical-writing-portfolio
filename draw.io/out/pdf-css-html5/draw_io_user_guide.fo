                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">When objects
                                        overlap, you can change their order to control which objects
                                        appear in front of or behind other objects. </fo:block></fo:block-container>
                                    <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">The arrangement options are<fo:block>

ent" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_17" chfox:nd-id="save_a_diagram_0"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title17"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Save a diagram</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 15 - <!--content(text)--><fo:inline>Save a diagram</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 15 - <!--content(text)--><fo:inline>Save a diagram</fo:inline></fo:marker><fo:inline>Chapter 15. </fo:inline><fo:inline>Save a diagram</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="0.5em"><fo:block end-indent="0" start-indent="0"/></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">You can save a diagram at any point while creating it. When you
                                    save a diagram, draw.io stores it in the selected location. You
                                    can save a diagram using Save or Save As. The option you use
                                    depends on whether you want to save changes to an existing
                                    diagram or save a diagram as a new file.</fo:block></fo:block-container>
                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_17_Connect_42_ul_kkj_x2l_wkc" chfox:nd-id="ul_kkj_x2l_wkc">
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="bold">Save:</fo:inline>Use this option
                                            to save changes to a diagram that has already been
                                            saved. For instructions, see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_18" fox:alt-text="Save changes to a diagram">Save changes to a
                                                diagram</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_18" fox:alt-text=" "><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_18"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_18"><fo:page-number-citation ref-id="unique_18"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_18">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0"><fo:inline font-weight="bold">Save as:</fo:inline> Use this
                                            option to save a new diagram or save an existing diagram
                                            with a different file name or location. For
                                            instructions, see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_19" fox:alt-text="Save a new diagram">Save a new
                                                diagram</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_19" fox:alt-text=" "><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_19"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_19"><fo:page-number-citation ref-id="unique_19"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_19">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>.
                                        </fo:block></fo:block-container>
                                    </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                </fo:list-block>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">When saving a diagram, you can select a supported online
                                    storage service or your local computer as the storage location,
                                    depending on the options available in your draw.io environment.
                                    This section covers the process of saving the file in the local
                                    system.</fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The XML (.drawio) format is selected by default when saving a
                                    diagram as a draw.io file. If you want to continue making
                                    changes to the diagram, save in this format.</fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                            <fo:block role="Sect" id="unique_18" chfox:nd-id="save_a_diagram">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title18"><fo:block end-indent="0" start-indent="0"><fo:inline>Save changes to a diagram</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To save
                                            changes to an existing diagram:</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>On the draw.io editor, click
                                                  <fo:inline font-weight="bold">File</fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Click<fo:inline font-weight="bold">Save</fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_18_Connect_42_result_drj_n3l_wkc" chfox:nd-id="result_drj_n3l_wkc"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">The selected
                                            location stores the diagram with the changes.</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                            <fo:block role="Sect" id="unique_19" chfox:nd-id="save_a_new_diagram">
                                <fo:block-container page-break-after="avoid" font-size="1.7em" space-after="0.5em" margin-left="0" margin-right="0" space-before="1em" role="H2" id="ariaid-title19"><fo:block end-indent="0" start-indent="0"><fo:inline>Save a new diagram</fo:inline></fo:block></fo:block-container>
                                <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                        <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To save a new
                                            diagram or save an existing diagram with a different
                                            name or location:</fo:block></fo:block-container>
                                    </fo:block></fo:block-container>
                                    <fo:block role="Sect">
                                        <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em">
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>On the draw.io editor, click
                                                  <fo:inline font-weight="bold">File</fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>On the menu, click <fo:inline font-weight="bold">Save
                                                  as</fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>In the dialog box that
                                                  appears, enter the file name.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Select the required storage
                                                  location.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                            <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                <fo:inline>Click<fo:inline font-weight="bold">Save</fo:inline>.</fo:inline>
                                            </fo:block></fo:list-item-body></fo:list-item>
                                        </fo:list-block>
                                    </fo:block>
                                    <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_19_Connect_42_result_otl_z3l_wkc" chfox:nd-id="result_otl_z3l_wkc"><fo:block end-indent="0" start-indent="0">The selected location stores new
                                        diagram with the changes.</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                            </fo:block>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_20" chfox:nd-id="export_a_diagram"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title20"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Export a diagram</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 16 - <!--content(text)--><fo:inline>Export a diagram</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 16 - <!--content(text)--><fo:inline>Export a diagram</fo:inline></fo:marker><fo:inline>Chapter 16. </fo:inline><fo:inline>Export a diagram</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="1em" space-before="1em" role="Sect"><fo:block end-indent="0" start-indent="0">
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">When you export a
                                        file in draw.io, it is saved as a non-editable format. You
                                        can use this format when you want to share, publish, embed,
                                        or use the diagram elsewhere.</fo:block></fo:block-container>
                                    <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">To export a
                                        file:</fo:block></fo:block-container>
                                </fo:block></fo:block-container>
                                <fo:block role="Sect">
                                    <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_20_Connect_42_steps_hwq_pjl_wkc" chfox:nd-id="steps_hwq_pjl_wkc">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">1. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>On the draw.io editor,
                                                  click<fo:inline font-weight="bold">
                                                  File</fo:inline>.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">2. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>On the menu, click <fo:inline font-weight="bold">Export
                                                  as</fo:inline>.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">3. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>On the submenu, click the
                                                format you want to export the file in.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">4. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>In the <fo:inline font-weight="bold">Image</fo:inline> dialog box, make the necessary
                                                changes.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">5. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                            <fo:inline>Click <fo:inline font-weight="bold">Export</fo:inline>.</fo:inline>
                                        </fo:block></fo:list-item-body></fo:list-item>
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">6. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:inline>In the dialog box that appears,
                                                do the following:</fo:inline>
                                            <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="0em" space-before="0em" id="unique_20_Connect_42_substeps_yy3_qml_wkc" chfox:nd-id="substeps_yy3_qml_wkc">
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">a. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Next to Save as, enter the
                                                  file name.</fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                                <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">b. </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>
                                                  <fo:inline>Next to Where, click the
                                                  dropdown to select the location to want the file
                                                  to be exported in.</fo:inline>
                                                </fo:block></fo:list-item-body></fo:list-item>
                                            </fo:list-block>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block>
                                </fo:block>
                                <fo:block-container space-after="1em" space-before="1em" role="Sect" id="unique_20_Connect_42_result_fnj_tll_wkc" chfox:nd-id="result_fnj_tll_wkc"><fo:block end-indent="0" start-indent="0">The exported file is saved in the
                                    provided location.</fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="xsl-footnote-separator" role="artifact" text-align="left" display-align="auto" font-size="10pt" font-family="Roboto , sans-serif" border-top-style="solid" border-top-color="black" border-top-width="thin" padding-top="8pt"><fo:block/></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block font-family="serif" font-size="12px" min-width="100%" xml:lang="en"><fo:block-container font-family="Roboto, sans-serif" font-size="10pt" margin-left="0" margin-right="0" min-width="100%"><fo:block end-indent="0" start-indent="0"><fo:block-container color="rgb(0 , 0 , 0)" line-height="1.7em" space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block><fo:block-container space-after="80px"><fo:block end-indent="0" start-indent="0"><fo:block xml:lang="en"><fo:block-container space-before="1em" role="Sect" id="unique_21" chfox:nd-id="frequently_asked_questions"><fo:block end-indent="0" start-indent="0">
                            <fo:block-container page-break-after="avoid" font-size="2em" line-height="1.1em" space-after="0.5em" margin-left="0" margin-right="0" space-before="0" role="H1" id="ariaid-title21"><fo:block end-indent="0" start-indent="0"><fo:marker marker-class-name="chaptertitle-only"><fo:inline/> <!--content(text)--><fo:inline>Frequently Asked Questions</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle-no-prefix"><fo:inline/> 17 - <!--content(text)--><fo:inline>Frequently Asked Questions</fo:inline></fo:marker><fo:marker marker-class-name="chaptertitle"><fo:inline/> | 17 - <!--content(text)--><fo:inline>Frequently Asked Questions</fo:inline></fo:marker><fo:inline>Chapter 17. </fo:inline><fo:inline>Frequently Asked Questions</fo:inline></fo:block></fo:block-container>
                            <fo:block-container space-after="0" margin-left="0" margin-right="0" space-before="0"><fo:block end-indent="0" start-indent="0">
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">This section answers frequently asked questions about using
                                    draw.io. It covers common questions about creating, editing,
                                    saving, and exporting diagrams.</fo:block></fo:block-container>
                                <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">Q.
                                    Why isn't the connector connecting to a shape?<fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_21_Connect_42_ul_myd_nzl_wkc" chfox:nd-id="ul_myd_nzl_wkc">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>This can
                                            happen when you are connecting two different shapes.
                                            When dragging the connector endpoint to the target
                                            shape, continue dragging until a connection point on the
                                            target shape is highlighted. Move the endpoint to the
                                            required connection point and release the connector.
                                        </fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block></fo:block></fo:block-container>
                                <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">Q.
                                    How do I bring an object in front of another object?<fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_21_Connect_42_ul_bdc_qzl_wkc" chfox:nd-id="ul_bdc_qzl_wkc">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">If two
                                                objects overlap and you want to move one in front of
                                                the other, select the object and choose Arrange &gt;
                                                To Front.</fo:block></fo:block-container>
                                            <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For more
                                                information, see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_16" fox:alt-text="Arrange overlapping objects">Arrange overlapping
                                                  objects</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_16" fox:alt-text=" "><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_16"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_16"><fo:page-number-citation ref-id="unique_16"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_16">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>.</fo:block></fo:block-container>
                                        </fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block></fo:block></fo:block-container>
                                <fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">Q.
                                    Why aren't my objects aligned?</fo:block></fo:block-container>
                                <fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_21_Connect_42_ul_jxj_h1m_wkc" chfox:nd-id="ul_jxj_h1m_wkc">
                                    <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block><fo:block-container><fo:block start-indent="0" end-indent="0">Select at
                                        least two objects before selecting Arrange &gt; Align.
                                        Alignment does not work when only one object is selected.<fo:block-container space-after="0.5em" margin-left="0" margin-right="0" space-before="1em"><fo:block end-indent="0" start-indent="0">For more
                                            information, see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_15" fox:alt-text="Align shapes">Align
                                                shapes</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_15" fox:alt-text=" "><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_15"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_15"><fo:page-number-citation ref-id="unique_15"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_15">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>.</fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:list-item-body></fo:list-item>
                                </fo:list-block>
                                <fo:block-container space-before="1em"><fo:block end-indent="0" start-indent="0">Q.
                                    Why is my exported diagram difficult to read?<fo:list-block relative-align="baseline" provisional-label-separation="3pt" provisional-distance-between-starts="40px" space-after="1.33em" space-before="1.33em" id="unique_21_Connect_42_ul_ddm_vbm_wkc" chfox:nd-id="ul_ddm_vbm_wkc">
                                        <fo:list-item><fo:list-item-label end-indent="label-end()"><fo:block text-align="end">• </fo:block></fo:list-item-label><fo:list-item-body start-indent="body-start()"><fo:block>The text
                                            or objects in the exported diagram may be difficult to
                                            read if the export settings are not suitable for the
                                            diagram. Review the export settings and adjust them as
                                            needed before exporting the diagram again. To learn
                                            more, see <fo:inline color="rgb(51 , 122 , 183)"><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_20" fox:alt-text="Export a diagram">Export a
                                                diagram</fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" internal-destination="unique_20" fox:alt-text=" "><fo:inline font-style="italic"><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_20"> (on page </fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_20"><fo:page-number-citation ref-id="unique_20"/></fo:basic-link><fo:basic-link show-destination="new" indicate-destination="true" fox:alt-text=" " internal-destination="unique_20">)</fo:basic-link></fo:inline></fo:basic-link></fo:inline>.</fo:block></fo:list-item-body></fo:list-item>
                                    </fo:list-block></fo:block></fo:block-container>
                            </fo:block></fo:block-container>
                        </fo:block></fo:block-container>
                        </fo:block></fo:block></fo:block-container></fo:block></fo:block></fo:block-container></fo:block></fo:block-container></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="chapter" force-page-count="no-force" id="last-page-sequence" line-height-shift-adjustment="disregard-shifts"><fo:static-content flow-name="sc-before-left" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-LEFT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="left" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="sectiontitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/> | <fo:page-number/></fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:static-content><fo:static-content flow-name="sc-before-right" role="artifact"><fo:table border-collapse="separate" table-layout="fixed" width="100%"><fo:table-body><fo:table-row><!--TOP-RIGHT--><fo:table-cell start-indent="0" end-indent="0" height="1in" width="(8.5in - 1in - 1in)" text-align="right" display-align="center" font-size="10pt" font-family="Roboto , sans-serif"><fo:block><fo:retrieve-marker retrieve-class-name="maptitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="parttitle" retrieve-boundary="document" retrieve-position="first-including-carryover"/><fo:retrieve-marker retrieve-class-name="chaptertitle" 